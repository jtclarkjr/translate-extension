{
  "name": "natural-translate-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension for OpenAI translation, pronunciation, and follow-up questions.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "build:safari:app": "wxt build -b safari && xcodebuild -project 'safari/Natural Translator/Natural Translator.xcodeproj' -scheme 'Natural Translator' -configuration Debug -derivedDataPath safari/build build",
    "zip": "wxt zip",
    "zip:chrome": "wxt zip -b chrome",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vp check --no-fmt --no-lint",
    "postinstall": "wxt prepare",
    "prepare": "vp config"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.102",
    "ai": "^7.0.153",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "vite-plus": "1.4.0",
    "wxt": "^0.20.27"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.4.0"
  },
  "packageManager": "bun@1.3.14"
}
